# Copy to .env.local; this file is safe to commit, real credentials are not.
BLUESTONE_TARGET=my-tenant-test
BLUESTONE_CLIENT_ID=replace-me
BLUESTONE_CLIENT_SECRET=replace-me
# Optional; defaults to an SDK-specific SQLite file under var/.
# BLUESTONE_MIGRATIONS_DATABASE_URL="sqlite:///%kernel.project_dir%/var/bluestone-migrations.db"

# Optional: required only for secured Public API operations, not Management API.
# BLUESTONE_PUBLIC_API_KEY=replace-me

# Required before using MediaUploadRunner. Use a unique secretbox key per environment:
# php -r 'echo base64_encode(random_bytes(SODIUM_CRYPTO_SECRETBOX_KEYBYTES)), PHP_EOL;'
# Keep the key in .env.local. List exact HTTPS hosts returned by this tenant's upload service.
# BLUESTONE_MEDIA_TRANSFER_KEY=base64-encoded-32-byte-key
# BLUESTONE_MEDIA_UPLOAD_HOSTS=uploads.example.com,bucket.example.net

# Optional: PostgreSQL/MySQL instead of SQLite. Create the database first.
# BLUESTONE_MIGRATIONS_DATABASE_URL="postgresql://user:password@127.0.0.1:5432/bluestone_migrations"
# BLUESTONE_MIGRATIONS_DATABASE_URL="mysql://user:password@127.0.0.1:3306/bluestone_migrations?charset=utf8mb4"
