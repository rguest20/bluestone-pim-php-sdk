{
    "bundles": {
        "Youwe\\BluestonePim\\BluestonePimBundle": ["all"]
    },
    "copy-from-recipe": {
        "src/Migration/.gitignore": "%SRC_DIR%/Migration/.gitignore"
    },
    "env": {
        "#1": "Bluestone PIM migration SDK local defaults. Replace the target and URLs for your tenant/environment.",
        "BLUESTONE_TARGET": "",
        "BLUESTONE_MIGRATIONS_DATABASE_URL": "sqlite:///%kernel.project_dir%/var/bluestone-migrations.db",
        "BLUESTONE_API_BASE_URL": "https://api.test.bluestonepim.com",
        "BLUESTONE_TOKEN_URL": "https://idp.test.bluestonepim.com/op/token",
        "BLUESTONE_CLIENT_ID": "",
        "BLUESTONE_CLIENT_SECRET": "",
        "BLUESTONE_PUBLIC_API_KEY": "",
        "BLUESTONE_MEDIA_TRANSFER_KEY": "",
        "BLUESTONE_MEDIA_UPLOAD_HOSTS": ""
    },
    "gitignore": ["/var/bluestone-migrations.db"]
}
